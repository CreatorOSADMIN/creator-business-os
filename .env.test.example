# Dummy values for CI and local test runs. Never put real secrets here.
# Copy to .env for local dev, or export as CI environment variables.

DATABASE_URL="postgresql://test:test@localhost:5432/test"
SESSION_SECRET="ci-test-session-secret-not-real"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="ci-test-password-not-real"

EMAIL_PROVIDER="console"
EMAIL_FROM="CreatorOS <hello@example.com>"

NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional — leave unset to disable Sentry.
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
