# Database (SQLite for local dev; swap for a postgresql:// URL in production)
DATABASE_URL="file:./dev.db"

# Admin authentication (required)
# ADMIN_PASSWORD can be plain text for local dev, or a bcrypt hash for production.
# Generate a hash with: npm run hash-password -- "your-password"
ADMIN_EMAIL="admin@creatoros.dev"
ADMIN_PASSWORD="ChangeMe123!"

# Session signing secret (required) — generate with: openssl rand -base64 32
SESSION_SECRET="replace-with-a-long-random-string"

# Email (optional in development — falls back to console logging)
EMAIL_PROVIDER="console"
EMAIL_FROM="CreatorOS <hello@creatoros.dev>"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""

NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Google Analytics 4 (optional — defaults to the production property if unset)
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-QE1TGJ9CMF"

# Content Analysis: YouTube Data API v3 key (optional — server-side only,
# never sent to the client). Without it, YouTube analyses report the
# provider as unavailable instead of running. Get one from
# https://console.cloud.google.com/apis/credentials with the "YouTube Data
# API v3" enabled. TikTok/Instagram don't have a real provider yet.
YOUTUBE_API_KEY=""
