@@ -1 +1,59 @@
 @import "tailwindcss";
+
+/* ---------------------------------------------------------------------- */
+/* Design tokens — CreatorOS landing surface                              */
+/* ---------------------------------------------------------------------- */
+@theme inline {
+  --color-bg: #0a0a0b;
+  --color-bg-elevated: #131316;
+  --color-bg-elevated-2: #1a1a1e;
+  --color-border: #232327;
+  --color-border-strong: #313136;
+  --color-text: #f5f4f0;
+  --color-text-muted: #93939c;
+  --color-text-faint: #5c5c63;
+  --color-accent: #f2b705;
+  --color-accent-dim: #b98c04;
+
+  --font-display: var(--font-display-family), ui-sans-serif, system-ui, sans-serif;
+  --font-mono-ui: var(--font-mono-ui-family), ui-monospace, SFMono-Regular, Menlo, monospace;
+}
+
+html {
+  scroll-behavior: smooth;
+}
+
+body {
+  background: var(--color-bg);
+  color: var(--color-text);
+}
+
+::selection {
+  background: var(--color-accent);
+  color: var(--color-bg);
+}
+
+:focus-visible {
+  outline: 2px solid var(--color-accent);
+  outline-offset: 2px;
+}
+
+h1, h2, h3, h4 {
+  letter-spacing: -0.03em;
+}
+
+/* Reveal-on-scroll primitive used by <Reveal>. Respects reduced motion. */
+@media (prefers-reduced-motion: reduce) {
+  .motion-safe-transition {
+    transition: none !important;
+  }
+}
+
+@keyframes glow-pulse {
+  0%, 100% { opacity: 0.55; }
+  50% { opacity: 1; }
+}
+
+.animate-glow-pulse {
+  animation: glow-pulse 4s ease-in-out infinite;
+}
