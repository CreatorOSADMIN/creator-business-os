+                <p className="mt-2 text-xs uppercase tracking-[0.1em] text-accent">{c.value}</p>
+                <p className="mt-1 text-sm text-text-muted">{c.label}</p>
+              </Reveal>
+            ))}
+          </div>
+        </div>
+      </section>
+
+      <ContentAnalysisFinalCta location="content_analysis_report_final_cta" />
+    </main>
+  );
+}
