generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Creator {
  id          String   @id @default(cuid())
  fullName    String
  creatorHandle String
  email       String   @unique
  country     String

  // Stored as JSON-encoded strings (kept as-is across the SQLite->PostgreSQL
  // migration to avoid changing application parsing logic)
  platforms       String // JSON array e.g. ["YOUTUBE","TIKTOK"]
  audienceSize    String
  publishingFrequency String
  creatorExperience   String
  biggestChallenge    String
  productInterests    String // JSON array

  marketingConsent Boolean @default(false)
  privacyAccepted  Boolean @default(false)
  // GDPR audit trail: when consent was given and which Privacy Policy
  // version was in effect at that time. Null for records created before
  // this field existed.
  gdprConsentAt        DateTime?
  privacyPolicyVersion String?

  // Kept as a validated string rather than a native enum (unchanged across
  // the SQLite->PostgreSQL migration to avoid an app-visible schema change).
  // Allowed values (enforced in application code, see src/lib/constants.ts):
  // NEW | CONTACTED | INTERVIEW_SCHEDULED | INTERESTED | BETA | PAID | REJECTED
  status      String @default("NEW")
  internalNotes String? // free text, admin-only

  referralCode   String  @unique
  referredBy     String? // referralCode of the referrer, if any
  // Set true only once this creator's own email has been verified, so a
  // referral isn't counted as qualified while the referred signup is still
  // pending confirmation.
  referralQualified Boolean @default(false)

  // Null until the creator clicks the link sent to their email address.
  emailVerifiedAt DateTime?

  utmSource   String?
  utmMedium   String?
  utmCampaign String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  referrer    Creator?  @relation("Referrals", fields: [referredBy], references: [referralCode])
  referrals   Creator[] @relation("Referrals")

  verificationTokens EmailVerificationToken[]
  contentAnalyses    ContentAnalysis[]

  @@index([status])
  @@index([country])
  @@index([referredBy])
}

// Public Q&A. Anyone can submit a question with a username (no account,
// no email/password). Questions start "pending" and are only shown on the
// public site once an admin answers and publishes them.
model Question {
  id       String @id @default(cuid())
  username String

  question String

  // URL slug, e.g. "how-does-creatoros-work". Generated from the question
  // text once it's first published; null while pending since the slug is
  // only meaningful for a page that actually exists publicly.
  slug String? @unique

  // Answer content (Markdown, rendered to sanitized HTML at render time).
  // Null until an admin writes an answer.
  answer String?

  // JSON-encoded string arrays of media URLs, kept as-is with the rest of
  // this codebase's convention for list fields (see Creator.platforms).
  answerImages String @default("[]")
  answerVideos String @default("[]")

  // Optional free-text category/topic, shown as a filter chip on /questions.
  category String?

  // pending | published — enforced in application code (see
  // src/lib/constants.ts), kept as a validated string rather than a native
  // enum for the same reasons documented on Creator.status.
  status String @default("pending")

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?

  // Denormalized count of real per-IP votes (see QuestionUpvote), kept in
  // sync transactionally alongside each QuestionUpvote insert so reads never
  // need a join/count. Separate from manualUpvotes so an admin override can
  // never clobber real user votes — the publicly displayed total is always
  // realUpvotes + manualUpvotes.
  realUpvotes   Int @default(0)
  manualUpvotes Int @default(0)

  upvoteRecords QuestionUpvote[]

  @@index([status, createdAt])
  @@index([status, publishedAt])
}

// One row per (question, voter) — enforced by the unique index below, which
// is what actually stops duplicate votes even if application-level checks
// are ever bypassed. The voter is identified by a salted hash of their IP
// (see src/lib/ip-hash.ts), never the raw address, so a database leak alone
// doesn't expose who voted from where.
model QuestionUpvote {
  id         String   @id @default(cuid())
  questionId String
  ipHash     String
  createdAt  DateTime @default(now())

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, ipHash])
  @@index([questionId])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  creatorId String
  // Only a SHA-256 hash of the token is stored; the raw token is sent to the
  // user via email and never persisted, so a database leak alone can't be
  // used to verify or hijack a pending registration.
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  creator Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@index([creatorId])
}

// Database foundation for the future real Content Analysis product (the
// current /content-analysis flow is a frontend-only demo, see
// src/lib/content-analysis.ts). Owner is optional so anonymous, pre-signup
// analyses can be persisted via anonymousId instead; no anonymous-id
// generation logic is implemented here, only the field.
model ContentAnalysis {
  id String @id @default(cuid())

  creatorId   String?
  anonymousId String?

  platform String
  goal     String

  // queued | processing | completed | failed — kept as a validated string
  // rather than a native enum, matching Creator.status / Question.status.
  // Allowed values enforced in application code (see src/lib/constants.ts).
  status String @default("queued")

  // JSON-encoded array of submitted video URLs (max 10, enforced in
  // application code), following the same list-field convention as
  // Creator.platforms / Question.answerImages.
  videoUrls  String @default("[]")
  videoCount Int    @default(0)

  errorMessage String?

  // Future analysis result payload, JSON-encoded once implemented in a
  // later patch. Intentionally untyped/nullable here.
  result String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  creator Creator? @relation(fields: [creatorId], references: [id], onDelete: SetNull)

  @@index([creatorId])
  @@index([anonymousId])
  @@index([status])
}
