diff --git a/src/app/globals.css b/src/app/globals.css
index ba04d6c..674b60b 100644
--- a/src/app/globals.css
+++ b/src/app/globals.css
@@ -27,6 +27,84 @@ html {
 body {
   background: var(--color-bg);
   color: var(--color-text);
+  position: relative;
+  isolation: isolate;
+}
+
+/* ------------------------------------------------------------------------ */
+/* Premium ambient background — layered mesh glow + vignette + micro-grid   */
+/* + film-grain noise. Pure CSS, fixed to the viewport, sits behind all     */
+/* content (z-index: -1 inside body's own stacking context via isolation). */
+/* Extremely low-contrast by design: it should read as "depth", not as a   */
+/* visible effect. No layout impact — both layers are position: fixed.     */
+/* ------------------------------------------------------------------------ */
+body::before {
+  content: "";
+  position: fixed;
+  inset: 0;
+  z-index: -1;
+  pointer-events: none;
+  background:
+    radial-gradient(1100px 700px at 12% -8%, color-mix(in srgb, var(--color-accent) 10%, transparent), transparent 60%),
+    radial-gradient(900px 620px at 108% 12%, color-mix(in srgb, var(--color-accent-dim) 8%, transparent), transparent 62%),
+    radial-gradient(1200px 800px at 50% 118%, color-mix(in srgb, var(--color-bg-elevated-2) 65%, transparent), transparent 65%),
+    radial-gradient(80% 60% at 50% 42%, transparent 45%, color-mix(in srgb, black 38%, transparent) 100%),
+    var(--color-bg);
+  background-repeat: no-repeat;
+  will-change: background-position, transform;
+  animation: ambient-drift 36s ease-in-out infinite alternate;
+}
+
+body::after {
+  content: "";
+  position: fixed;
+  inset: 0;
+  z-index: -1;
+  pointer-events: none;
+  opacity: 0.5;
+  background-image:
+    repeating-linear-gradient(
+      to right,
+      color-mix(in srgb, var(--color-text) 4%, transparent) 0,
+      color-mix(in srgb, var(--color-text) 4%, transparent) 1px,
+      transparent 1px,
+      transparent 120px
+    ),
+    repeating-linear-gradient(
+      to bottom,
+      color-mix(in srgb, var(--color-text) 3%, transparent) 0,
+      color-mix(in srgb, var(--color-text) 3%, transparent) 1px,
+      transparent 1px,
+      transparent 120px
+    ),
+    url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='160' height='160'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='2' stitchTiles='stitch'/><feColorMatrix type='saturate' values='0'/></filter><rect width='100%25' height='100%25' filter='url(%23n)' opacity='0.05'/></svg>");
+  mask-image: radial-gradient(90% 75% at 50% 38%, black 55%, transparent 100%);
+  -webkit-mask-image: radial-gradient(90% 75% at 50% 38%, black 55%, transparent 100%);
+}
+
+@keyframes ambient-drift {
+  from {
+    background-position:
+      12% -8%,
+      108% 12%,
+      50% 118%,
+      50% 42%,
+      0 0;
+  }
+  to {
+    background-position:
+      16% -4%,
+      104% 16%,
+      50% 114%,
+      50% 42%,
+      0 0;
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  body::before {
+    animation: none !important;
+  }
 }
 
