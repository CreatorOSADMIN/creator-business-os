diff --git a/src/components/motion/scroll-reveal.tsx b/src/components/motion/scroll-reveal.tsx
new file mode 100644
index 0000000..0000000
--- /dev/null
+++ b/src/components/motion/scroll-reveal.tsx
@@ -0,0 +1,54 @@
+"use client";
+
+import { useEffect, useRef, type ReactNode } from "react";
+
+interface ScrollRevealProps {
+  children: ReactNode;
+  className?: string;
+}
+
+/**
+ * Fades/slides its content into view the first time it enters the
+ * viewport, using IntersectionObserver. Purely additive on top of the
+ * existing landing page markup: renders a single wrapping <div> with the
+ * caller's own layout classes (grid, gaps, etc.) plus a `reveal` class that
+ * starts hidden and adds `is-visible` once observed (see globals.css).
+ *
+ * Degrades gracefully: if IntersectionObserver isn't available, or the
+ * element is already in view on mount, content is shown immediately with
+ * no animation.
+ */
+export function ScrollReveal({ children, className = "" }: ScrollRevealProps) {
+  const ref = useRef<HTMLDivElement>(null);
+
+  useEffect(() => {
+    const node = ref.current;
+    if (!node) return;
+
+    if (typeof IntersectionObserver === "undefined") {
+      node.classList.add("is-visible");
+      return;
+    }
+
+    const observer = new IntersectionObserver(
+      (entries) => {
+        for (const entry of entries) {
+          if (entry.isIntersecting) {
+            entry.target.classList.add("is-visible");
+            observer.unobserve(entry.target);
+          }
+        }
+      },
+      { threshold: 0.15, rootMargin: "0px 0px -60px 0px" }
+    );
+
+    observer.observe(node);
+    return () => observer.disconnect();
+  }, []);
+
+  return (
+    <div ref={ref} className={`reveal ${className}`}>
+      {children}
+    </div>
+  );
+}
