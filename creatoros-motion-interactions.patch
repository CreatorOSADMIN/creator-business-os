diff --git a/src/components/scroll-animations.tsx b/src/components/scroll-animations.tsx
new file mode 100644
index 0000000..48785c6
--- /dev/null
+++ b/src/components/scroll-animations.tsx
@@ -0,0 +1,34 @@
+"use client";
+
+import { useEffect } from "react";
+
+/**
+ * Mounts once on the homepage and observes every element carrying the
+ * `.reveal` class, adding `.is-visible` the first time it scrolls into
+ * view. Dependency-free (native IntersectionObserver) — the actual
+ * fade/slide transition lives entirely in globals.css, this component only
+ * toggles the class.
+ */
+export function ScrollAnimations() {
+  useEffect(() => {
+    const elements = document.querySelectorAll<HTMLElement>(".reveal:not(.is-visible)");
+    if (elements.length === 0) return;
+
+    const observer = new IntersectionObserver(
+      (entries) => {
+        for (const entry of entries) {
+          if (entry.isIntersecting) {
+            entry.target.classList.add("is-visible");
+            observer.unobserve(entry.target);
+          }
+        }
+      },
+      { threshold: 0.15, rootMargin: "0px 0px -10% 0px" }
+    );
+
+    elements.forEach((el) => observer.observe(el));
+    return () => observer.disconnect();
+  }, []);
+
+  return null;
+}
